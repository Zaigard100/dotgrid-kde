        bb.rejected.connect(d.close)
        lay = QVBoxLayout(d)
        lay.addWidget(view)
        lay.addWidget(bb)
        d.show()

    def refresh(self):
        """Puts the current state into the widgets without echoing it back."""
        try:
            self.isVisible()
        except RuntimeError:         # closed and deleted; the signal may still fire once
            return
        if LANG[0] != self.lang:     # language changed: rebuild in the new one
            self.close()
            QTimer.singleShot(0, self.tray.show_settings)
            return
        st, cfg = self.svc.status(), self.svc.cfg
        was = self._building
        self._building = True
        try:
            for path, apply in self.binds:
                apply(cfg_get(cfg, path))
            theme = {"day": T("день", "day"), "night": T("ночь", "night")}.get(self.svc.theme, "?")
            self.theme_label.setText(T("Сейчас тема: ", "Current theme: ") + f"<b>{theme}</b>")
            self.pause.setText(T("Продолжить", "Resume") if cfg["paused"] else T("Пауза", "Pause"))
            if cfg["paused"]:
                state = T("Пауза вручную.", "Paused manually.")
            elif st["auto_paused"]:
                state = T("Автопауза: ", "Auto-paused: ") + ", ".join(rule_name(r) for r in st["auto_reasons"]) + "."
            else:
                state = T("Анимация идёт. Часы идут всегда.", "Animation running. The clocks always run.")
            self.state_label.setText(state)
            self.turn_label.setText(T(f"Оборот: {cfg['galaxy_turn_minutes']:g} мин", f"One turn: {cfg['galaxy_turn_minutes']:g} min"))
            self.key_label.setText(T("Пауза с клавиатуры: ", "Pause key: ") + f"<b>{cfg['shortcut']}</b>")
        finally:
            self._building = was


class Tray(QObject):
    """Tray icon and menu. The menu is built once and its actions are never
    deleted: the panel (plasmashell) shows it over DBus, and rebuilding it
    while it is open left plasmashell pointing at a deleted action (crash in
    QMenu::timerEvent). Changes only update text, checks and visibility."""

    def __init__(self, svc, app):
        super().__init__()
        self.svc, self.app = svc, app
        self.tray = QSystemTrayIcon()
        self.menu = QMenu()
        self.items = []          # (action, text(), checked() or None, visible() or None)
        self._build()
        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self._activated)
        svc.stateChanged.connect(self.update)
        self.update()
        self.tray.show()

    # ---- windows ----
    def _reopen(self, attr, factory):
        w = getattr(self, attr, None)
        try:
            if w is not None and w.isVisible():
                w.raise_()
                w.activateWindow()
                return
        except RuntimeError:          # already deleted on close
            pass
        w = factory()
        setattr(self, attr, w)
        w.show()

    def show_settings(self):
        self._reopen("settings", lambda: SettingsWindow(self.svc, self))

    def show_help(self):
        self._reopen("help", lambda: HelpWindow(self.svc))

    def _activated(self, reason):
        if reason == QSystemTrayIcon.Trigger:
            self.svc.Toggle()
        elif reason == QSystemTrayIcon.MiddleClick:
            self.show_settings()

    # ---- menu, built once ----
    def _act(self, menu, text, slot, checked=None, visible=None, group=None):
        a = menu.addAction(text())
        if checked is not None:
            a.setCheckable(True)
            if group is not None:
                group.addAction(a)
        a.triggered.connect(slot)
        self.items.append((a, text, checked, visible))
        return a

    def _sub(self, menu, text):
        sub = menu.addMenu(text())
        self.items.append((sub.menuAction(), text, None, None))
        return sub

    def _radio(self, menu, text, key, items):
        sub = self._sub(menu, text)
        grp = QActionGroup(sub)
        for value, label in items:
            self._act(sub, label, lambda _=False, v=value: self.svc.set_value(key, v),
                      checked=lambda v=value: cfg_get(self.svc.cfg, key) == v, group=grp)

    def _toggle(self, menu, text, key):
        self._act(menu, text, lambda on, k=key: self.svc.set_value(k, on),
                  checked=lambda: cfg_get(self.svc.cfg, key))

    def _build(self):
        m, cfg = self.menu, lambda: self.svc.cfg
        self._act(m, lambda: T("Продолжить", "Resume") if cfg()["paused"] else T("Пауза", "Pause"), self.svc.Toggle)
        self._act(m, lambda: T("Настройки…", "Settings…"), self.show_settings)
        m.addSeparator()

        th = self._sub(m, lambda: T("Тема", "Theme"))
        grp = QActionGroup(th)
        for value, label in (("day", lambda: T("день", "day")), ("night", lambda: T("ночь", "night"))):
            self._act(th, label, lambda _=False, v=value: self.svc.Theme(v),
                      checked=lambda v=value: self.svc.theme == v and cfg()["mode"] == "auto", group=grp)
        th.addSeparator()
        self._act(th, lambda: T("по расписанию сейчас", "by schedule now"), lambda: self.svc.Theme("schedule"))
        forced = lambda: T("день", "day") if cfg()["mode"] == "day" else T("ночь", "night")
        self._act(th, lambda: T(f"обои принудительно: {forced()} — вернуть за темой",
                                f"wallpaper forced: {forced()} — follow the theme"),
                  lambda: self.svc.set_value("mode", "auto"), visible=lambda: cfg()["mode"] != "auto")

        self._radio(m, lambda: T("Кубики и трубы", "Bars and pipes"), "bars",
                    [("audio", lambda: T("звук", "audio")), ("generative", lambda: T("волны", "waves")),
                     ("system", lambda: T("система", "system"))])
        fps = self._sub(m, lambda: "FPS")
        for key, label in (("night", lambda: T("ночью", "at night")), ("day", lambda: T("днём", "by day"))):
            self._radio(fps, label, f"fps.{key}", [(f, lambda f=f: str(f)) for f in CHOICES["fps"]])
        el = self._sub(m, lambda: T("Элементы", "Elements"))
        for e in ELEMENTS:
            self._toggle(el, lambda e=e: element_name(e), f"elements.{e}")
        self._radio(m, lambda: T("«Жизнь»: режим", "Life: mode"), "life_mode",
                    [("random", lambda: T("случайная", "random")), ("edges", lambda: T("края + центр", "edges + centre")),
                     ("draw", lambda: T("рисование кликом", "draw with clicks"))])
        ap = self._sub(m, lambda: T("Автопауза", "Auto-pause"))
        self._toggle(ap, lambda: T("Энергосбережение", "Power saver"), "autopause.powersaver")
        thr = lambda: cfg()["autopause"]["battery_threshold"]
        self._toggle(ap, lambda: T(f"Батарея < {thr()}%", f"Battery < {thr()}%"), "autopause.battery")
        self._toggle(ap, lambda: T("Экран заблокирован / сеанс неактивен", "Screen locked / session idle"),
                     "autopause.locked")
        m.addSeparator()
        mb = lambda: cfg()["metrics_max_mb"]
        self._toggle(m, lambda: T(f"Записывать замер нагрузки (архив до {mb():g} МБ)",
                                  f"Record load metrics (archive up to {mb():g} MB)"), "metrics")
        self._radio(m, lambda: "Язык / Language", "language", [("ru", lambda: "Русский"), ("en", lambda: "English")])
        m.addSeparator()
        self._act(m, lambda: T("Справка: что есть что", "Help: what is what"), self.show_help)
        self._act(m, lambda: T("Выход", "Quit"), self.app.quit)

    def update(self):
        st, cfg = self.svc.status(), self.svc.cfg
        fg = self.app.palette().windowText().color()
        if cfg["paused"]:
            kind, tip = "paused", T("DotGrid Live: пауза", "DotGrid Live: paused")
        elif st["auto_paused"]:
            kind = "auto"
            tip = T("DotGrid Live: автопауза (", "DotGrid Live: auto-paused (") + \
                ", ".join(rule_name(r) for r in st["auto_reasons"]) + ")"
        else:
            kind, tip = "running", T("DotGrid Live: идёт", "DotGrid Live: running")
        if (kind, fg.name()) != getattr(self, "icon_key", None):     # colour follows the theme
            self.icon_key = (kind, fg.name())
            self.tray.setIcon(make_icon(kind, fg))
        self.tray.setToolTip(tip)
        # in place: only what actually changed is sent to the panel
        for a, text, checked, visible in self.items:
            s = text()
            if a.text() != s:
                a.setText(s)
            if checked is not None and a.isChecked() != bool(checked()):
                a.setChecked(bool(checked()))
            if visible is not None and a.isVisible() != bool(visible()):
                a.setVisible(bool(visible()))


class Shortcut(QObject):
    """Global shortcut through KGlobalAccel; the user can rebind it in System Settings."""
    COMPONENT = "dotgrid-live"
    ACTION = ["dotgrid-live", "toggle-pause", "DotGrid Live", "Пауза / продолжить анимацию обоев"]
    # Qt key codes: Meta 0x10000000, Shift 0x02000000, Ctrl 0x04000000, Alt 0x08000000
    MODS = {"meta": 0x10000000, "shift": 0x02000000, "ctrl": 0x04000000, "alt": 0x08000000}

    def __init__(self, svc, keys):
        super().__init__()
        self.svc = svc
        self.ok = False
        code = self._code(keys)
        if code is None:
            return
        try:
            ids = "[" + ",".join(f"'{s}'" for s in self.ACTION) + "]"
            base = ["gdbus", "call", "--session", "-d", "org.kde.kglobalaccel", "-o", "/kglobalaccel", "-m"]
            subprocess.run(base + ["org.kde.KGlobalAccel.doRegister", ids], capture_output=True, timeout=5, check=True)
            # default first, then the present value (keeps a binding the user changed)
            subprocess.run(base + ["org.kde.KGlobalAccel.setShortcut", ids, f"[{code}]", "1"],
                           capture_output=True, timeout=5, check=True)
            subprocess.run(base + ["org.kde.KGlobalAccel.setShortcut", ids, f"[{code}]", "2"],
                           capture_output=True, timeout=5, check=True)
        except (OSError, subprocess.SubprocessError):
            return
        path = "/component/" + self.COMPONENT.replace("-", "_")
        self.ok = QDBusConnection.sessionBus().connect(
            "org.kde.kglobalaccel", path, "org.kde.kglobalaccel.Component", "globalShortcutPressed",
            self, SLOT("onPressed(QDBusMessage)"))

    def _code(self, keys):
        parts = [p.strip().lower() for p in keys.split("+")]
        code = 0
        for p in parts[:-1]:
            if p not in self.MODS:
                return None
            code |= self.MODS[p]
        last = parts[-1].upper()
        if len(last) != 1 or not last.isalnum():
            return None
        return code | ord(last)

    @Slot(QDBusMessage)
    def onPressed(self, msg):
        args = msg.arguments()
        if len(args) >= 2 and args[1] == "toggle-pause":
            self.svc.Toggle()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("dotgrid-livectl")
    app.setQuitOnLastWindowClosed(False)

    bus = QDBusConnection.sessionBus()
    if not bus.registerService("org.dotgrid.Live"):
        print("dotgrid-livectl: already running", file=sys.stderr)
        return 1
    svc = LiveService()
    bus.registerObject("/org/dotgrid/Live", svc,
                       QDBusConnection.ExportAllSlots | QDBusConnection.ExportAllSignals)
    if "--no-tray" not in sys.argv:
        tray = Tray(svc, app)  # noqa: F841 (kept alive)
    shortcut = Shortcut(svc, svc.cfg["shortcut"])
    if not shortcut.ok:
        print("dotgrid-livectl: global shortcut not registered", file=sys.stderr)
    svc._emit()
    # SIGTERM (systemd) / SIGINT (terminal): Python handlers only run when the
    # interpreter gets control, so the signal wakes the Qt loop through a
    # socket instead of a polling timer; the process sleeps while idle.
    rsock, wsock = socket.socketpair()
    rsock.setblocking(False)
    wsock.setblocking(False)
    signal.set_wakeup_fd(wsock.fileno())
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda *_: app.quit())
    notifier = QSocketNotifier(rsock.fileno(), QSocketNotifier.Read)
    notifier.activated.connect(lambda *_: rsock.recv(64))
    rc = app.exec()
    svc.shutdown()
    return rc


if __name__ == "__main__":
    sys.exit(main())
