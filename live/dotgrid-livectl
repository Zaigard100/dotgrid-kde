def log(msg):
    """One line to stderr, i.e. the journal under systemd."""
    print(f"dotgrid-livectl: {msg}", file=sys.stderr, flush=True)


def merge(base, extra):
    """Defaults overlaid with whatever valid keys the file has."""
    out = copy.deepcopy(base)
    for k, v in (extra or {}).items():
        if k in out and isinstance(out[k], dict) and isinstance(v, dict):
            out[k] = merge(out[k], v)
        elif k in out and not isinstance(out[k], dict):
            out[k] = v
    return out


def load_config():
    try:
        with open(CONFIG) as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = {}
    if isinstance(raw.get("fps"), int):          # older files: one fps for both
        raw["fps"] = {"day": raw["fps"], "night": raw["fps"]}
    return merge(DEFAULTS, raw)


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, CONFIG)


def validate(key, value):
    """Returns (path, value) to store or raises ValueError. "fps" alone sets
    both day and night (the path then is ["fps"] with a dict value)."""
    parts = key.split(".")
    if key in ("mode", "bars", "life_mode", "language"):
        if value not in CHOICES[key]:
            raise ValueError(f"{key}: one of {', '.join(CHOICES[key])}")
    elif parts[0] == "fps" and len(parts) <= 2:
        v = int(value)
        if v not in CHOICES["fps"]:
            raise ValueError("fps: one of 15, 24, 30, 60")
        if len(parts) == 1:
            value = {"day": v, "night": v}
        elif parts[1] in ("day", "night"):
            value = v
        else:
            raise ValueError("fps.day or fps.night")
    elif key in ("paused", "metrics"):
        value = bool(value)
    elif key == "galaxy_turn_minutes":
        value = float(value)
        if not 0.25 <= value <= 120:
            raise ValueError("galaxy_turn_minutes: 0.25..120")
    elif key == "metrics_max_mb":
        value = float(value)
        if not 0.1 <= value <= 100:
            raise ValueError("metrics_max_mb: 0.1..100")
    elif key == "life_rate":
        value = float(value)
        if not 0.2 <= value <= 20:
            raise ValueError("life_rate: 0.2..20")
    elif parts[0] == "elements" and len(parts) == 2 and parts[1] in ELEMENTS:
        value = bool(value)
    elif parts[0] == "opts" and len(parts) == 3 and (parts[1], parts[2]) in OPTS:
        spec = OPTS[(parts[1], parts[2])]
        if isinstance(spec, list):
            if value not in spec:
                raise ValueError(f"{key}: one of {', '.join(spec)}")
        elif spec[0] is bool:
            value = bool(value)
        else:
            value = spec[0](value)
            if not spec[1] <= value <= spec[2]:
                raise ValueError(f"{key}: {spec[1]}..{spec[2]}")
    elif parts[0] == "autopause" and len(parts) == 2 and parts[1] in DEFAULTS["autopause"]:
        if parts[1] == "battery_threshold":
            value = int(value)
            if not 1 <= value <= 100:
                raise ValueError("battery_threshold: 1..100")
        else:
            value = bool(value)
    else:
        raise ValueError(f"unknown setting: {key}")
    return parts, value


class Sensors(QObject):
    """Power profile, battery and lock state from the system/session buses."""
    changed = Signal()

    def __init__(self):
        super().__init__()
        self.sys = QDBusConnection.systemBus()
        self.ses = QDBusConnection.sessionBus()
        self.profile = None          # "power-saver" | "balanced" | "performance" | None
        self.on_battery = False
        self.percent = None
        self.screensaver = False
        self.locked = False
        self.idle = False
        self.session_active = True
        self.session_path = self._find_session()
        self.has_ppd = self._get(self.sys, "net.hadess.PowerProfiles", "/net/hadess/PowerProfiles",
                                 "net.hadess.PowerProfiles", "ActiveProfile") is not None

        watch = [
            (self.sys, "org.freedesktop.UPower", "/org/freedesktop/UPower"),
            (self.sys, "org.freedesktop.UPower", "/org/freedesktop/UPower/devices/DisplayDevice"),
        ]
        if self.has_ppd:
            watch.append((self.sys, "net.hadess.PowerProfiles", "/net/hadess/PowerProfiles"))
        if self.session_path:
            watch.append((self.sys, "org.freedesktop.login1", self.session_path))
        for bus, svc, path in watch:
            bus.connect(svc, path, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                        self, SLOT("onSignal(QDBusMessage)"))
        self.ses.connect("org.freedesktop.ScreenSaver", "/ScreenSaver", "org.freedesktop.ScreenSaver",
                         "ActiveChanged", self, SLOT("onSignal(QDBusMessage)"))
        if not self.has_ppd:
            # KDE PowerDevil keeps the profile itself when power-profiles-daemon is absent
            self.ses.connect("org.kde.Solid.PowerManagement", "/org/kde/Solid/PowerManagement/Actions/PowerProfile",
                             "org.kde.Solid.PowerManagement.Actions.PowerProfile", "currentProfileChanged",
                             self, SLOT("onSignal(QDBusMessage)"))
        self.refresh()

    @staticmethod
    def _call(bus, svc, path, iface, method, *args):
        m = QDBusMessage.createMethodCall(svc, path, iface, method)
        m.setArguments(list(args))
        r = bus.call(m)
        if r.type() != QDBusMessage.ReplyMessage or not r.arguments():
            return None
        return r.arguments()[0]

    def _get(self, bus, svc, path, iface, prop):
        v = self._call(bus, svc, path, "org.freedesktop.DBus.Properties", "Get", iface, prop)
        return v.variant() if hasattr(v, "variant") else v

    def _find_session(self):
        # A systemd --user service is outside the graphical session, so ask
        # logind for the session of this user's display.
        sid = os.environ.get("XDG_SESSION_ID")
        if not sid:
            try:
                sid = subprocess.run(["loginctl", "show-user", str(os.getuid()), "-p", "Display", "--value"],
                                     capture_output=True, text=True, timeout=3).stdout.strip()
            except (OSError, subprocess.SubprocessError):
                sid = ""
        if not sid:
            return None
        p = self._call(self.sys, "org.freedesktop.login1", "/org/freedesktop/login1",
                       "org.freedesktop.login1.Manager", "GetSession", sid)
        return p.path() if isinstance(p, QDBusObjectPath) else (p or None)

    @Slot(QDBusMessage)
    def onSignal(self, _msg):
        self.refresh()

    def refresh(self):
        before = self.snapshot()
        if self.has_ppd:
            self.profile = self._get(self.sys, "net.hadess.PowerProfiles", "/net/hadess/PowerProfiles",
                                     "net.hadess.PowerProfiles", "ActiveProfile")
        else:
            self.profile = self._call(self.ses, "org.kde.Solid.PowerManagement",
                                      "/org/kde/Solid/PowerManagement/Actions/PowerProfile",
                                      "org.kde.Solid.PowerManagement.Actions.PowerProfile", "currentProfile")
        self.on_battery = bool(self._get(self.sys, "org.freedesktop.UPower", "/org/freedesktop/UPower",
                                         "org.freedesktop.UPower", "OnBattery"))
        present = self._get(self.sys, "org.freedesktop.UPower", "/org/freedesktop/UPower/devices/DisplayDevice",
                            "org.freedesktop.UPower.Device", "IsPresent")
        pct = self._get(self.sys, "org.freedesktop.UPower", "/org/freedesktop/UPower/devices/DisplayDevice",
                        "org.freedesktop.UPower.Device", "Percentage")
        self.percent = round(pct) if present and pct is not None else None
        self.screensaver = bool(self._call(self.ses, "org.freedesktop.ScreenSaver", "/ScreenSaver",
                                           "org.freedesktop.ScreenSaver", "GetActive"))
        if self.session_path:
            g = lambda p: self._get(self.sys, "org.freedesktop.login1", self.session_path,
                                    "org.freedesktop.login1.Session", p)
            self.locked = bool(g("LockedHint"))
            self.idle = bool(g("IdleHint"))
            active = g("Active")
            self.session_active = True if active is None else bool(active)
        if self.snapshot() != before:
            self.changed.emit()

    def snapshot(self):
        return dict(profile=self.profile, on_battery=self.on_battery, percent=self.percent,
                    screensaver=self.screensaver, locked=self.locked, idle=self.idle,
                    session_active=self.session_active)


SOURCE_NONE, SOURCE_AUDIO, SOURCE_SYSTEM = 0, 1, 2
NBARS, NPIPES = 26, 4


def pack(source, bars=(), pipes=()):
    """[source, 26 bars, 4 pipes] as bytes, values 0..1 -> 0..255"""
    q = lambda v: max(0, min(255, int(round(v * 255))))
    bars = list(bars) + [0] * (NBARS - len(bars))
    pipes = list(pipes) + [0] * (NPIPES - len(pipes))
    return bytes([source] + [q(v) for v in bars[:NBARS]] + [q(v) for v in pipes[:NPIPES]])


class Audio(QObject):
    """Spectrum of what the speakers play: the default sink's monitor through
    pw-record, analysed with numpy. Nothing is captured unless it is wanted
    AND some stream is actually playing (pactl subscribe, event driven); in
    silence the FFT is skipped and after 3 s the wallpaper gets SOURCE_NONE."""
    levels = Signal(bytes)
    RATE, N = 16000, 1024
    SILENCE_DB, SILENCE_S = -55.0, 3.0

    def __init__(self):
        super().__init__()
        self.want = False
        self.fps = 15
        self.sub = None          # pactl subscribe
        self.rec = None          # pw-record
        self.np = None
        self.target = os.environ.get("DOTGRID_AUDIO_TARGET")   # tests: capture another node

    fall, range_db, peak_fall = 0.09, 42.0, 0.03

    def tune(self, fall, sensitivity, peak_fall):
        """Bars fall speed, sensitivity (smaller dB range = more lit), peak fall."""
        self.fall = 0.09 * fall
        self.range_db = 42.0 / sensitivity
        self.peak_fall = 0.03 * peak_fall

    def set_wanted(self, want, fps):
        self.fps = max(5, min(30, fps))
        if want == self.want:
            return
        self.want = want
        if want:
            self._start_watch()
        else:
            self._stop_watch()
            self._stop_capture()

    # ---- is anything playing? ----
    def _start_watch(self):
        self.sub = QProcess(self)
        self.sub.readyReadStandardOutput.connect(self._on_events)
        self.sub.start("pactl", ["subscribe"])
        self._check_playing()

    def _stop_watch(self):
        if self.sub:
            self.sub.kill()
            self.sub.waitForFinished(500)
            self.sub = None

    def _on_events(self):
        data = bytes(self.sub.readAllStandardOutput()).decode(errors="replace")
        if "sink-input" in data:
            self._check_playing()

    def _check_playing(self):
        try:
            out = subprocess.run(["pactl", "-f", "json", "list", "sink-inputs"],
                                 capture_output=True, text=True, timeout=3).stdout
            playing = any(not s.get("corked", False) for s in json.loads(out or "[]"))
        except (OSError, subprocess.SubprocessError, ValueError):
            playing = False
        if playing and self.want:
            self._start_capture()
        else:
            self._stop_capture()

    # ---- capture + analysis ----
    def _start_capture(self):
        if self.rec:
            return
        if self.np is None:
            import numpy
            self.np = numpy
            n = self.N
            self.window = numpy.hanning(n).astype(numpy.float32)
            freqs = numpy.fft.rfftfreq(n, 1 / self.RATE)
            edges = numpy.geomspace(60, 7000, NBARS + 1)
            # bin ranges per band, at least one bin each
            self.bands = [(int(numpy.searchsorted(freqs, lo)), max(int(numpy.searchsorted(freqs, lo)) + 1,
                                                                    int(numpy.searchsorted(freqs, hi))))
                          for lo, hi in zip(edges[:-1], edges[1:])]
        np = self.np
        self.frames = np.zeros((self.N, 2), dtype=np.float32)
        self.pending = bytearray()
        self.smooth = np.zeros(NBARS, dtype=np.float32)
        self.peaks = np.zeros(2, dtype=np.float32)
        self.ref = -30.0
        self.loud_at = time.monotonic()
        self.silent = False
        self.rec = QProcess(self)
        # Qt buffers the pipe; Python looks at it on a timer (frame rate,
        # 2 Hz in silence) instead of waking up for every small chunk
        self.reader = QTimer(self)
        self.reader.timeout.connect(self._on_audio)
        self.reader.start(int(1000 / self.fps))
        args = ["-P", "{ stream.capture.sink=true node.name=dotgrid-live-spectrum "
                      "node.description=\"DotGrid Live spectrum\" }",
                "--rate", str(self.RATE), "--channels", "2", "--format", "s16",
                "--latency", "50ms", "--raw", "-"]
        if self.target:
            args[2:2] = ["--target", self.target]
        self.rec.start("pw-record", args)
        log("audio capture started")

    def _stop_capture(self):
        if self.rec:
            self.reader.stop()
            log("audio capture stopped")
            self.rec.kill()
            self.rec.waitForFinished(500)
            self.rec = None
            self.levels.emit(pack(SOURCE_NONE))

    def _on_audio(self):
        np = self.np
        self.pending += bytes(self.rec.readAllStandardOutput())
        whole = len(self.pending) // 4 * 4
        if not whole:
            return
        chunk = np.frombuffer(bytes(self.pending[:whole]), dtype=np.int16).reshape(-1, 2)
        del self.pending[:whole]
        chunk = chunk[-self.N:].astype(np.float32) / 32768.0
        self.frames = np.concatenate((self.frames[len(chunk):], chunk))
        self._analyse(time.monotonic())
        self.reader.setInterval(500 if self.silent else int(1000 / self.fps))

    def _analyse(self, now):
        np = self.np
        rms = np.sqrt(np.mean(self.frames ** 2, axis=0)) + 1e-9
        db = 20 * np.log10(rms)
        if db.max() < self.SILENCE_DB:
            if not self.silent and now - self.loud_at > self.SILENCE_S:
                self.silent = True
                log("audio: silence")
                self.levels.emit(pack(SOURCE_NONE))
            if self.silent:
                return              # nothing to show, skip the FFT
        else:
            self.loud_at = now
            if self.silent:
                log("audio: sound")
            self.silent = False
        mono = self.frames.mean(axis=1) * self.window
        mag = np.abs(np.fft.rfft(mono)) / (self.N / 4)          # ~1.0 for a full-scale sine
        bdb = np.array([10 * np.log10(np.mean(mag[a:b] ** 2) + 1e-12) for a, b in self.bands])
        # slow automatic gain: the loudest band sets the top of the scale
        self.ref = max(self.ref - 0.15, float(bdb.max()), -45.0)
        level = np.clip((bdb - (self.ref - self.range_db)) / self.range_db, 0.0, 1.0)
        self.smooth = np.maximum(level, self.smooth - self.fall)  # fast attack, slow fall
        vu = np.clip((db + 50.0) / 50.0, 0.0, 1.0)
        self.peaks = np.maximum(vu, self.peaks - self.peak_fall)
        self.levels.emit(pack(SOURCE_AUDIO, self.smooth, [vu[0], vu[1], self.peaks[0], self.peaks[1]]))


class SystemStats(QObject):
    """CPU history for the bars; CPU, RAM, network in/out for the pipes. 1 Hz,
    only while wanted."""
    levels = Signal(bytes)

    def __init__(self):
        super().__init__()
        self.timer = QTimer(self)
        self.timer.setInterval(1000)
        self.timer.timeout.connect(self._tick)
        self.history = deque([0.0] * NBARS, maxlen=NBARS)
        self.prev_cpu = None
        self.prev_net = None

    def set_wanted(self, want):
        if want == self.timer.isActive():
            return
        if want:
            self.prev_cpu = self.prev_net = None
            self._tick()
            self.timer.start()
        else:
            self.timer.stop()
            self.levels.emit(pack(SOURCE_NONE))

    @staticmethod
    def _iface():
        try:
            with open("/proc/net/route") as f:
                for line in f.readlines()[1:]:
                    p = line.split()
                    if p[1] == "00000000":
                        return p[0]
        except OSError:
            pass
        return None

    def _tick(self):
        with open("/proc/stat") as f:
            v = [int(x) for x in f.readline().split()[1:]]
        idle, total = v[3] + v[4], sum(v)
        cpu = 0.0
        if self.prev_cpu:
            dt = total - self.prev_cpu[1]
            cpu = 1.0 - (idle - self.prev_cpu[0]) / dt if dt > 0 else 0.0
        self.prev_cpu = (idle, total)
        self.history.append(cpu)

        mem = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, val = line.split(":")
                mem[k] = int(val.split()[0])
        ram = 1.0 - mem.get("MemAvailable", 0) / max(1, mem.get("MemTotal", 1))

        rx = tx = 0.0
        iface = self._iface()
        if iface:
            try:
                base = f"/sys/class/net/{iface}/statistics/"
                cur = (int(open(base + "rx_bytes").read()), int(open(base + "tx_bytes").read()), time.monotonic())
                if self.prev_net:
                    dt = max(1e-3, cur[2] - self.prev_net[2])
                    # log scale: 1 KB/s .. 100 MB/s
                    scale = lambda b: max(0.0, min(1.0, (math.log10(max(b, 1)) - 3) / 5))
                    rx = scale((cur[0] - self.prev_net[0]) / dt)
                    tx = scale((cur[1] - self.prev_net[1]) / dt)
                self.prev_net = cur
            except (OSError, ValueError):
                pass
        self.levels.emit(pack(SOURCE_SYSTEM, self.history, [cpu, ram, rx, tx]))


def hourly_snapshot(rows, hour_ts):
    """One compact record for the minute rows of one clock hour."""
    if not rows:
        return None
    mean = lambda xs: round(sum(xs) / len(xs), 2) if xs else None
    groups = {}
    for r in rows:
        if r["paused"]:
            k = "paused:" + ("+".join((["manual"] if r["manual"] else []) + r["auto"]) or "?")
        else:
            k = f"{r['mode']}:{r['bars']}{'+audio' if r.get('audio_capture') else ''}:{r['fps']}"
        groups.setdefault(k, []).append(r)
    state = {}
    for k, rs in groups.items():
        ps_k = [r["plasmashell_cpu"] for r in rs if r.get("plasmashell_cpu") is not None]
        w_k = [r["battery_w"] for r in rs if r.get("battery_status") == "Discharging" and r.get("battery_w")]
        state[k] = {"min": len(rs), "ps_cpu": mean(ps_k), "ps_n": len(ps_k),
                    "bat_w": mean(w_k), "bat_min": len(w_k)}
    ps = [r["plasmashell_cpu"] for r in rows if r.get("plasmashell_cpu") is not None]
    rss = [r for r in rows if r.get("plasmashell_rss_kb")]
    disch = [r for r in rows if r.get("battery_status") == "Discharging" and r.get("battery_w")]
    pct = [r["battery_pct"] for r in rows if r.get("battery_pct") is not None]
    profiles = [r.get("profile") for r in rows if r.get("profile")]
    return {
        "hour": time.strftime("%Y-%m-%dT%H", time.localtime(hour_ts)),
        "min": len(rows),
        "state": state,
        "audio_min": sum(1 for r in rows if r.get("audio_capture")),
        "bars": max(set(r["bars"] for r in rows), key=[r["bars"] for r in rows].count),
        "fps": max(set(r["fps"] for r in rows), key=[r["fps"] for r in rows].count),
        "ps_cpu": mean(ps), "ps_cpu_max": max(ps) if ps else None,
        "svc_cpu": mean([r["service_cpu"] for r in rows if r.get("service_cpu") is not None]),
        "rec_cpu": mean([r["pw_record_cpu"] for r in rows if r.get("pw_record_cpu") is not None]),
        "ps_rss_mb": [round(min(r["plasmashell_rss_kb"] for r in rss) / 1024),
                      round(max(r["plasmashell_rss_kb"] for r in rss) / 1024),
                      round(rss[-1]["plasmashell_rss_kb"] / 1024)] if rss else None,
        "ps_pid": rss[-1].get("plasmashell_pid") if rss else None,
        "bat_w": mean([r["battery_w"] for r in disch]), "bat_min": len(disch),
        "bat_pct": [pct[0], pct[-1]] if pct else None,
        "profile": max(set(profiles), key=profiles.count) if profiles else None,
    }


def _xz_lines(path):
    """All lines of a (multi-stream) xz file."""
    import lzma
    try:
        with lzma.open(path) as f:
            return f.read().splitlines(keepends=True)
    except (OSError, lzma.LZMAError):
        return []


def _plain_lines(path):
    try:
        with open(path, "rb") as f:
            return f.readlines()
    except OSError:
        return []


def _write_xz(path, lines):
    import lzma
    tmp = path + ".tmp"
    with lzma.open(tmp, "wb", preset=9 | lzma.PRESET_EXTREME) as f:
        f.write(b"".join(lines))
    os.replace(tmp, path)


def hourly_migrate():
    """Older versions kept one xz file per month: fold them into ARCHIVE."""
    try:
        months = sorted(f for f in os.listdir(HOURLY_DIR) if f.endswith(".jsonl.xz") and f != os.path.basename(ARCHIVE))
    except OSError:
        return
    if not months:
        return
    lines = []
    for name in months:
        lines += _xz_lines(os.path.join(HOURLY_DIR, name))
    def hour(l):
        try:
            return json.loads(l)["hour"]
        except (ValueError, KeyError):
            return ""
    _write_xz(ARCHIVE, sorted(_xz_lines(ARCHIVE) + lines, key=hour))
    for name in months:
        os.remove(os.path.join(HOURLY_DIR, name))
    log(f"metrics: {len(months)} monthly files merged into {ARCHIVE}")


def hourly_append(snaps):
    """New hours go to TODAY (plain, at most a day). Finished days are
    compressed together and appended to ARCHIVE as one more xz stream, so a
    whole day compresses well and nothing old is ever rewritten."""
    import lzma
    os.makedirs(HOURLY_DIR, exist_ok=True)
    with open(TODAY, "ab") as f:
        for s in snaps:
            f.write((json.dumps(s, ensure_ascii=False, separators=(",", ":")) + "\n").encode())
    today = time.strftime("%Y-%m-%d")
    lines = _plain_lines(TODAY)
    done = [l for l in lines if json.loads(l)["hour"][:10] < today]
    if done:
        with lzma.open(ARCHIVE, "ab", preset=9 | lzma.PRESET_EXTREME) as f:
            f.write(b"".join(done))
        keep = [l for l in lines if json.loads(l)["hour"][:10] >= today]
        tmp = TODAY + ".tmp"
        with open(tmp, "wb") as f:
            f.writelines(keep)
        os.replace(tmp, TODAY)


def hourly_cap(cap_bytes):
    """The only size limit: ARCHIVE + TODAY. Over it, the oldest quarter of
    the archived hours goes and the archive is rewritten as one stream."""
    size = lambda: sum(os.path.getsize(p) for p in (ARCHIVE, TODAY) if os.path.exists(p))
    while size() > cap_bytes:
        lines = _xz_lines(ARCHIVE)
        if len(lines) < 4:
            break                     # nothing sensible left to drop
        keep = lines[len(lines) // 4:]
        _write_xz(ARCHIVE, keep)
        log(f"metrics: archive over the limit, kept {len(keep)} of {len(lines)} hours")


def hourly_last():
    """The last archived hour ("YYYY-MM-DDTHH") or None."""
    for lines in (_plain_lines(TODAY), _xz_lines(ARCHIVE)):
        for l in reversed(lines):
            try:
                return json.loads(l)["hour"]
            except (ValueError, KeyError):
                continue
    return None


class Metrics(QObject):
    """Background measurement, off by default: once a minute one JSON line
    with the CPU/RAM of plasmashell, of this service and of pw-record, the
    battery draw, and what the wallpaper was doing. `dotgrid-live metrics`
    summarises it. Costs one wake-up per minute.
    Minute rows live only until their hour is over: then they are folded
    into one snapshot (TODAY, then once a day into the single ARCHIVE) and
    dropped, so the minute file stays at about one hour. Only the archive
    has a size limit (metrics_max_mb); the oldest hours go first."""
    INTERVAL_S = 60

    def __init__(self, svc):
        super().__init__()
        self.svc = svc
        self.timer = QTimer(self)
        self.timer.setInterval(self.INTERVAL_S * 1000)
        self.timer.timeout.connect(self._sample)
        self.prev = {}                # name -> (pid, ticks, monotonic)
        self.tck = os.sysconf("SC_CLK_TCK")

    def set_enabled(self, on):
        if on == self.timer.isActive():
            return
        if on:
            self.prev = {}
            try:
                hourly_migrate()
            except OSError as e:
                log(f"metrics: {e}")
            self._sample()            # first sample only primes the deltas
            self.timer.start()
            log(f"metrics on -> {METRICS}")
        else:
            self.timer.stop()
            log("metrics off")

    @staticmethod
    def _pid(comm):
        for d in os.listdir("/proc"):
            if d.isdigit():
                try:
                    with open(f"/proc/{d}/comm") as f:
                        if f.read().strip() == comm:
                            return int(d)
                except OSError:
                    pass
        return None

    @staticmethod
    def _proc(pid):
        try:
            with open(f"/proc/{pid}/stat") as f:
                v = f.read().rsplit(")", 1)[1].split()
            ticks = int(v[11]) + int(v[12])
            with open(f"/proc/{pid}/status") as f:
                rss = next(int(l.split()[1]) for l in f if l.startswith("VmRSS:"))
            return ticks, rss
        except (OSError, StopIteration, ValueError, IndexError):
            return None

    def _cpu(self, name, pid, now):
        """% of one core since the last sample (None on the first one)."""
        if pid is None:
            return None, None
        r = self._proc(pid)
        if r is None:
            return None, None
        ticks, rss = r
        pct = None
        p = self.prev.get(name)
        if p and p[0] == pid and now > p[2]:
            pct = round((ticks - p[1]) * 100.0 / self.tck / (now - p[2]), 2)
        self.prev[name] = (pid, ticks, now)
        return pct, rss

    @staticmethod
    def _battery():
        for dev in sorted(os.listdir("/sys/class/power_supply")):
            base = f"/sys/class/power_supply/{dev}/"
            try:
                if open(base + "type").read().strip() != "Battery":
                    continue
                status = open(base + "status").read().strip()
                watts = None
                if os.path.exists(base + "power_now"):
                    watts = int(open(base + "power_now").read()) / 1e6
                elif os.path.exists(base + "current_now"):
                    watts = int(open(base + "current_now").read()) * int(open(base + "voltage_now").read()) / 1e12
                return status, round(watts, 2) if watts is not None else None
            except (OSError, ValueError):
                continue
        return None, None

    def _sample(self):
        now = time.monotonic()
        st = self.svc.status()
        ps_pid = self._pid("plasmashell")
        ps_cpu, ps_rss = self._cpu("plasmashell", ps_pid, now)
        me_cpu, me_rss = self._cpu("self", os.getpid(), now)
        rec = self.svc.audio.rec
        rec_pid = rec.processId() if rec and rec.processId() else None
        rec_cpu, _ = self._cpu("pw-record", rec_pid, now)
        bstatus, watts = self._battery()
        row = {
            "ts": int(time.time()),
            "mode": st["effective_mode"] or "?",
            "paused": st["effective_paused"],
            "manual": st["paused"],
            "auto": st["auto_reasons"],
            "bars": st["bars"],
            "audio_capture": rec_pid is not None,
            "fps": st["fps"]["night" if st["effective_mode"] == "night" else "day"],
            "off": [k for k, v in st["elements"].items() if not v],
            "plasmashell_pid": ps_pid, "plasmashell_cpu": ps_cpu, "plasmashell_rss_kb": ps_rss,
            "service_cpu": me_cpu, "service_rss_kb": me_rss,
            "pw_record_cpu": rec_cpu,
            "battery_status": bstatus, "battery_w": watts,
            "battery_pct": st["sensors"]["percent"], "profile": st["sensors"]["profile"],
        }
        if ps_cpu is None and me_cpu is None:
            return                     # priming sample
        try:
            os.makedirs(os.path.dirname(METRICS), exist_ok=True)
            with open(METRICS, "a") as f:
                f.write(json.dumps(row, ensure_ascii=False) + "\n")
            self._rollup(int(st["metrics_max_mb"] * 1024 * 1024))
        except OSError as e:
            log(f"metrics: {e}")

    def _rollup(self, cap):
        """Once per clock hour: fold the finished hours into the archive and
        keep only the current hour in the minute file."""
        hour_now = time.strftime("%Y-%m-%dT%H")
        if getattr(self, "rolled", None) == hour_now:
            return
        last = hourly_last()
        rows = []
        with open(METRICS) as f:
            for line in f:
                try:
                    rows.append(json.loads(line))
                except ValueError:
                    pass
        by_hour = {}
        for r in rows:
            h = time.strftime("%Y-%m-%dT%H", time.localtime(r["ts"]))
            if h < hour_now and (last is None or h > last):
                by_hour.setdefault(h, []).append(r)
        if by_hour:
            hourly_append([hourly_snapshot(by_hour[h], by_hour[h][0]["ts"]) for h in sorted(by_hour)])
            hourly_cap(cap)
            hs = sorted(by_hour)
            log(f"metrics: archived {len(hs)} h ({hs[0]}" + (f" .. {hs[-1]})" if len(hs) > 1 else ")"))
        current = [r for r in rows if time.strftime("%Y-%m-%dT%H", time.localtime(r["ts"])) >= hour_now]
        if len(current) < len(rows):
            tmp = METRICS + ".tmp"
            with open(tmp, "w") as f:
                f.writelines(json.dumps(r, ensure_ascii=False) + "\n" for r in current)
            os.replace(tmp, METRICS)
        self.rolled = hour_now


@ClassInfo({"D-Bus Interface": "org.dotgrid.Live"})
class LiveService(QObject):
    """Exported on the session bus; also the in-process API for tray and shortcut."""
    Changed = Signal(str)
    Levels = Signal(QByteArray)
    stateChanged = Signal()

    def __init__(self):
        super().__init__()
        self.cfg = load_config()
        LANG[0] = self.cfg.get("language", "ru")
        self.audio = Audio()
        self.system = SystemStats()
        self._last_levels = None
        self.audio.levels.connect(self._levels)
        self.system.levels.connect(self._levels)
        self.metrics = Metrics(self)
        self.sensors = Sensors()
        self.sensors.changed.connect(self._emit)
        self.theme = self._read_theme()
        self.watch = QFileSystemWatcher()
        self._rewatch()
        self.watch.fileChanged.connect(self._on_file)
        self.watch.directoryChanged.connect(self._on_file)
        self._last_json = None

    # ---- files ----
    def _rewatch(self):
        for p in [CONFIG, THEME_STATE, os.path.dirname(CONFIG), os.path.dirname(THEME_STATE)]:
            if os.path.exists(p) and p not in self.watch.files() + self.watch.directories():
                self.watch.addPath(p)

    def _read_theme(self):
        try:
            with open(THEME_STATE) as f:
                t = f.read().strip()
            return t if t in ("day", "night") else None
        except OSError:
            return None

    def _on_file(self, _path):
        self._rewatch()
        self.theme = self._read_theme()
        cfg = load_config()
        if cfg != self.cfg:       # edited by hand or by the CLI without the service
            self.cfg = cfg
        self._emit()

    # ---- state ----
    def auto_reasons(self):
        a, s, out = self.cfg["autopause"], self.sensors, []
        if a["powersaver"] and s.profile == "power-saver":
            out.append("powersaver")
        if a["battery"] and s.on_battery and s.percent is not None and s.percent < a["battery_threshold"]:
            out.append("battery")
        if a["locked"] and (s.screensaver or s.locked or s.idle or not s.session_active):
            out.append("locked")
        return out

    def status(self):
        reasons = self.auto_reasons()
        mode = self.cfg["mode"]
        st = copy.deepcopy(self.cfg)
        st.update({
            "daemon": True,
            "version": VERSION,
            "auto_paused": bool(reasons),
            "auto_reasons": reasons,
            "effective_paused": self.cfg["paused"] or bool(reasons),
            "effective_mode": mode if mode != "auto" else self.theme,   # None: wallpaper decides
            "sensors": self.sensors.snapshot(),
        })
        return st

    def _emit(self):
        LANG[0] = self.cfg.get("language", "ru")
        st = self.status()
        js = json.dumps(st, ensure_ascii=False)
        if js != self._last_json:
            self._last_json = js
            self.Changed.emit(js)
            self.stateChanged.emit()
        reasons = (st["paused"], tuple(st["auto_reasons"]))
        if reasons != getattr(self, "_last_reasons", None):
            self._last_reasons = reasons
            log(f"paused={st['paused']} auto={','.join(st['auto_reasons']) or '-'}")
        self._update_sources(st)

    def _update_sources(self, st):
        # data is only gathered while the night bars/pipes can show it
        visible = (not st["effective_paused"] and st["effective_mode"] != "day"
                   and (st["elements"]["bars"] or st["elements"]["pipes"]))
        o = st["opts"]
        self.audio.tune(o["bars"]["fall"], o["bars"]["sensitivity"], o["pipes"]["peak_fall"])
        self.audio.set_wanted(visible and st["bars"] == "audio", st["fps"]["night"])
        self.system.set_wanted(visible and st["bars"] == "system")
        self.metrics.set_enabled(st["metrics"])

    def _levels(self, data):
        if data != self._last_levels:
            self._last_levels = data
            self.Levels.emit(QByteArray(data))

    def set_value(self, key, value):
        parts, value = validate(key, value)
        node = self.cfg
        for p in parts[:-1]:
            node = node[p]
        if node[parts[-1]] == value:
            return
        node[parts[-1]] = value
        save_config(self.cfg)
        self._emit()

    def shutdown(self):
        self.audio.set_wanted(False, 15)
        self.system.set_wanted(False)
        self.metrics.set_enabled(False)

    # ---- DBus API ----
    @Slot(result=str)
    def Status(self):
        return json.dumps(self.status(), ensure_ascii=False)

    @Slot()
    def Pause(self):
        self.set_value("paused", True)

    @Slot()
    def Resume(self):
        self.set_value("paused", False)

    @Slot()
    def Toggle(self):
        self.set_value("paused", not self.cfg["paused"])

    @Slot(str, str, result=str)
    def Set(self, key, value_json):
        try:
            self.set_value(key, json.loads(value_json))
        except (ValueError, TypeError) as e:
            return str(e)
        return ""

    @Slot(str, result=str)
    def Theme(self, which):
        """Whole theme (colours, icons, Konsole, kitty, lock screen) through the
        DotGrid scripts; the wallpaper goes back to following it."""
        tool = {"day": "dotgrid-theme", "night": "dotgrid-theme", "schedule": "dotgrid-auto"}.get(which)
        if not tool:
            return "theme: one of day, night, schedule"
        path = shutil.which(tool) or os.path.expanduser(f"~/.local/bin/{tool}")
        if not os.access(path, os.X_OK):
            # no DotGrid theme installed: at least switch the wallpaper
            self.set_value("mode", "auto" if which == "schedule" else which)
            return f"{tool} not found, switched the wallpaper only"
        self.set_value("mode", "auto")
        args = [which] if tool == "dotgrid-theme" else ["--force"]
        QProcess.startDetached(path, args)
        log(f"theme {which} via {tool}")
        return ""


def make_icon(kind, color):
    """running: 3x3 dot grid; paused: two bars; auto: two hollow bars."""
    pm = QPixmap(44, 44)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    c = QColor(color)
    if kind == "running":
        p.setPen(Qt.NoPen)
        p.setBrush(c)
        for y in range(3):
            for x in range(3):
                p.drawEllipse(QPointF(8 + x * 14, 8 + y * 14), 4.5, 4.5)
    else:
        for x in (10, 26):
            r = QRectF(x, 6, 8, 32)
            if kind == "paused":
                p.setPen(Qt.NoPen)
                p.setBrush(c)
            else:
                pen = p.pen()
                pen.setColor(c)
                pen.setWidthF(3)
                p.setPen(pen)
                p.setBrush(Qt.NoBrush)
                r.adjust(1.5, 1.5, -1.5, -1.5)
            p.drawRect(r)
    p.end()
    return QIcon(pm)


