class HelpWindow(QDialog):
    """Opened from the tray; built on demand and destroyed on close."""

    def __init__(self, svc):
        super().__init__()
        self.setAttribute(Qt.WA_DeleteOnClose)
        self.setWindowTitle(T("DotGrid Live — справка", "DotGrid Live — help"))
        self.resize(900, 900)
        night = (svc.status()["effective_mode"] or svc.theme) == "night"
        colors = (dict(ink="#e8e0d0", bg="#0a0a0a", dim="#8a877e", code="#1c1c1a") if night else
                  dict(ink="#161614", bg="#d6cdbc", dim="#6e685c", code="#c8bfac"))
        self.setStyleSheet(f"QDialog {{ background: {colors['bg']}; }}")
        view = QTextBrowser(self)
        view.setOpenExternalLinks(True)
        view.setFont(QFont("JetBrains Mono", 10))
        view.setStyleSheet(f"QTextBrowser {{ background: {colors['bg']}; color: {colors['ink']}; border: none; }}")
        view.document().setDefaultStyleSheet(HELP_CSS % colors)
        st = svc.status()
        st["audio_capture"] = svc.audio.rec is not None
        view.setHtml(help_html(st))
        buttons = QDialogButtonBox(QDialogButtonBox.Close, self)
        buttons.rejected.connect(self.close)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(18, 18, 18, 12)
        lay.addWidget(view)
        lay.addWidget(buttons)


def cfg_get(cfg, path):
    node = cfg
    for p in path.split("."):
        node = node[p]
    return node


class SettingsWindow(QDialog):
    """Every setting in one window, on three tabs. Changes apply at once; the
    window follows changes made from the tray or the CLI. Built on demand,
    freed on close; reopens itself when the language changes."""

    def __init__(self, svc, tray):
        super().__init__()
        self.svc, self.tray = svc, tray
        self.lang = LANG[0]
        self.binds = []              # (path, apply-to-widget function)
        self._building = True
        self.setAttribute(Qt.WA_DeleteOnClose)
        self.setWindowTitle(T("DotGrid Live — настройки", "DotGrid Live — settings"))
        self.resize(820, 760)

        tabs = QTabWidget()
        tabs.addTab(self._scroll(self._general()), T("Общее", "General"))
        tabs.addTab(self._scroll(self._night()), T("Ночь", "Night"))
        tabs.addTab(self._scroll(self._day()), T("День", "Day"))

        bottom = QHBoxLayout()
        self.key_label = QLabel()
        bottom.addWidget(self.key_label)
        b = QPushButton(T("Изменить…", "Change…"))
        b.setToolTip(T("Параметры → Комбинации клавиш → DotGrid Live", "System Settings → Shortcuts → DotGrid Live"))
        b.clicked.connect(lambda: QProcess.startDetached("kcmshell6", ["kcm_keys"]))
        bottom.addWidget(b)
        bottom.addStretch(1)
        for label, slot in ((T("Справка", "Help"), tray.show_help),
                            (T("Открыть live.json", "Open live.json"), lambda: QProcess.startDetached("xdg-open", [CONFIG])),
                            (T("Закрыть", "Close"), self.close)):
            b = QPushButton(label)
            b.clicked.connect(slot)
            bottom.addWidget(b)

        lay = QVBoxLayout(self)
        lay.addWidget(tabs, 1)
        lay.addLayout(bottom)
        svc.stateChanged.connect(self.refresh)
        self.refresh()
        self._building = False

    # ---- building blocks ----
    @staticmethod
    def _scroll(widget):
        s = QScrollArea()
        s.setWidgetResizable(True)
        s.setFrameShape(QScrollArea.NoFrame)
        s.setWidget(widget)
        return s

    @staticmethod
    def _hint(text):
        h = QLabel(text)
        h.setWordWrap(True)
        h.setEnabled(False)          # greyed: an explanation, not a control
        return h

    def _set(self, key, value):
        if not self._building:
            self.svc.set_value(key, value)

    def _form(self, box):
        f = QFormLayout()
        f.setFieldGrowthPolicy(QFormLayout.ExpandingFieldsGrow)
        box.layout().addLayout(f)
        return f

    def _dspin(self, form, label, path, lo, hi, step, decimals=1, suffix=""):
        w = QDoubleSpinBox()
        w.setRange(lo, hi)
        w.setSingleStep(step)
        w.setDecimals(decimals)
        w.setSuffix(suffix)
        w.valueChanged.connect(lambda v: self._set(path, round(v, decimals)))
        self.binds.append((path, w.setValue))
        form.addRow(label, w)
        return w

    def _ispin(self, form, label, path, lo, hi, suffix="", special=None):
        w = QSpinBox()
        w.setRange(lo, hi)
        w.setSuffix(suffix)
        if special:
            w.setSpecialValueText(special)
        w.valueChanged.connect(lambda v: self._set(path, v))
        self.binds.append((path, w.setValue))
        form.addRow(label, w)
        return w

    def _combo(self, form, label, path, items):
        w = QComboBox()
        for value, text in items:
            w.addItem(text, value)
        w.currentIndexChanged.connect(lambda _: self._set(path, w.currentData()))
        self.binds.append((path, lambda v: w.setCurrentIndex(w.findData(v))))
        if form is not None:
            form.addRow(label, w)
        return w

    def _check(self, layout, label, path):
        w = QCheckBox(label)
        w.toggled.connect(lambda on: self._set(path, on))
        self.binds.append((path, w.setChecked))
        layout.addWidget(w)
        return w

    def _element(self, e, title, hint):
        """A group whose own checkbox switches the element on and off."""
        g = QGroupBox(f"{element_name(e)} — {title}")
        g.setCheckable(True)
        g.toggled.connect(lambda on: self._set(f"elements.{e}", on))
        self.binds.append((f"elements.{e}", g.setChecked))
        v = QVBoxLayout(g)
        v.addWidget(self._hint(hint))
        return g

    # ---- tabs ----
    def _general(self):
        page = QWidget()
        col = QVBoxLayout(page)

        g = QGroupBox(T("Тема", "Theme"))
        v = QVBoxLayout(g)
        row = QHBoxLayout()
        for label, which in ((T("День", "Day"), "day"), (T("Ночь", "Night"), "night"),
                             (T("По расписанию", "By schedule"), "schedule")):
            b = QPushButton(label)
            b.clicked.connect(lambda _=False, w=which: self.svc.Theme(w))
            row.addWidget(b)
        v.addLayout(row)
        self.theme_label = QLabel()
        v.addWidget(self.theme_label)
        v.addWidget(self._hint(T("Меняет всю тему DotGrid: цвета KDE, иконки, Konsole, kitty, экран блокировки. Ручной выбор держится до следующего переключения по расписанию.",
                                 "Switches the whole DotGrid theme: KDE colours, icons, Konsole, kitty, lock screen. A manual choice lasts until the next scheduled switch.")))
        f = self._form(g)
        self._combo(f, T("Обои:", "Wallpaper:"), "mode", [("auto", T("за темой", "follow the theme")),
                                                         ("day", T("всегда день", "always day")),
                                                         ("night", T("всегда ночь", "always night"))])
        col.addWidget(g)

        g = QGroupBox(T("Анимация", "Animation"))
        v = QVBoxLayout(g)
        self.pause = QPushButton()
        self.pause.clicked.connect(self.svc.Toggle)
        v.addWidget(self.pause)
        self.state_label = QLabel()
        self.state_label.setWordWrap(True)
        v.addWidget(self.state_label)
        f = self._form(g)
        fps = [(x, str(x)) for x in CHOICES["fps"]]
        self._combo(f, T("FPS ночью:", "FPS at night:"), "fps.night", fps)
        self._combo(f, T("FPS днём:", "FPS by day:"), "fps.day", fps)
        v.addWidget(self._hint(T("Ночью — частота всей сцены и анализа звука. Днём — только скорость перебора букв: «Жизнь» и плитки идут своим темпом. Каждые +15 кадров стоят около +5% одного ядра.",
                                 "At night — the rate of the whole scene and of the audio analysis. By day — only the letter flicker: Life and the tiles keep their own pace. Each +15 fps costs about +5% of one core.")))
        f = self._form(g)
        self._combo(f, T("Кубики и трубы:", "Bars and pipes:"), "bars",
                    [("audio", T("звук (что играет в колонки)", "audio (what the speakers play)")),
                     ("generative", T("волны (без датчиков)", "waves (no sensors)")),
                     ("system", T("система (CPU, RAM, сеть)", "system (CPU, RAM, network)"))])
        col.addWidget(g)

        g = QGroupBox(T("Автопауза", "Auto-pause"))
        v = QVBoxLayout(g)
        self._check(v, T("профиль «энергосбережение»", "power-saver profile"), "autopause.powersaver")
        self._check(v, T("экран заблокирован или сеанс простаивает", "screen locked or session idle"), "autopause.locked")
        self._check(v, T("от батареи и заряд ниже порога", "on battery below the threshold"), "autopause.battery")
        f = self._form(g)
        self._ispin(f, T("Порог батареи:", "Battery threshold:"), "autopause.battery_threshold", 1, 100, " %")
        v.addWidget(self._hint(T("Ручную паузу автопауза не снимает и не ставит.", "Auto-pause never sets or clears a manual pause.")))
        col.addWidget(g)

        g = QGroupBox(T("Замер нагрузки", "Load metrics"))
        v = QVBoxLayout(g)
        self._check(v, T("записывать раз в минуту", "record once a minute"), "metrics")
        f = self._form(g)
        self._dspin(f, T("Лимит архива:", "Archive limit:"), "metrics_max_mb", 0.1, 100, 0.5, 1, T(" МБ", " MB"))
        v.addWidget(self._hint(T("Часовые снимки в сжатом архиве, меньше 1 КБ в сутки.", "Hourly snapshots in a compressed archive, under 1 KB a day.")))
        b = QPushButton(T("Сводка…", "Summary…"))
        b.clicked.connect(self._summary)
        v.addWidget(b)
        col.addWidget(g)

        g = QGroupBox(T("Язык / Language", "Language / Язык"))
        f = QFormLayout(g)
        self._combo(f, "", "language", [("ru", "Русский"), ("en", "English")])
        col.addWidget(g)
        col.addStretch(1)
        return page

