    def _summary(self):
        cli = os.path.join(os.path.dirname(os.path.realpath(__file__)), "dotgrid-live")
        try:
            text = subprocess.run([cli, "metrics"], capture_output=True, text=True, timeout=20).stdout
            text += "\n" + subprocess.run([cli, "metrics", "hourly", "1"], capture_output=True, text=True,
                                          timeout=20).stdout
