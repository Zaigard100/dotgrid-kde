post_install() {
  cat <<'MSG'
DotGrid Live: per user, once:
  systemctl --user enable --now dotgrid-livectl.service
  then choose "DotGrid Live" in Desktop > Configure Desktop and Wallpaper
  (with the DotGrid theme installed: mkdir -p ~/.config/dotgrid && touch ~/.config/dotgrid/live.enabled,
   so dotgrid-theme stops swapping the static picture)
MSG
}
post_upgrade() {
  echo "DotGrid Live: restart the service: systemctl --user restart dotgrid-livectl.service"
}
